# Security Configuration for Claude + GitHub + n8n Integration
# Copy this file to .env and fill in your actual values

# Webhook Security
WEBHOOK_SECRET=your-strong-webhook-secret-here-min-32-chars
N8N_WEBHOOK_URL=https://your-n8n-instance.com  # MUST be HTTPS

# GitHub Configuration
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_OAUTH_CLIENT_ID=your_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-your-anthropic-api-key-here

# Security Settings
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
MAX_DIFF_SIZE_BYTES=50000
MAX_COMMENT_LENGTH=65000

# Monitoring Configuration
LOG_LEVEL=info
SECURITY_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90

# Network Security
ALLOWED_ORIGINS=github.com,api.github.com
CORS_ENABLED=false
HTTPS_ONLY=true

# Content Filtering
ENABLE_CONTENT_FILTERING=true
REDACT_SENSITIVE_DATA=true
MAX_CONTENT_LENGTH=100000